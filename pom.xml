<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-quarkus-parent</artifactId>
        <version>1.7.7</version>
        <relativePath/>
    </parent>
    <groupId>de.cuioss.notary.audit</groupId>
    <artifactId>audit-notary-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- Must be declared: <inceptionYear> is inherited, and the license plugin binds the
         copyright ${year} to it. Without this, a new project reports cui-parent-pom's 2022
         and every -Ppre-commit run restamps every header. customize.sh sets this. -->
    <inceptionYear>2026</inceptionYear>
    <name>Audit Notary</name>
    <description>Audit Notary: security documents on the Git server you already run. Every change signed, every version on record. Quarkus native, with a web app and an MCP server for AI agents.
    </description>
    <url>https://github.com/cuioss/Audit-Notary/</url>
    <scm>
        <url>https://github.com/cuioss/Audit-Notary/</url>
        <connection>
            scm:git:https://github.com/cuioss/Audit-Notary.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/cuioss/Audit-Notary/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/cuioss/Audit-Notary/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>
    <properties>
        <!-- Target Java 25; CI also builds on 27 (.github/project.yml, maven-build.java-versions). -->
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Token Sheriff: the OIDC confidential-client engine and the bearer validation (ADR-0001). -->
        <version.token-sheriff>0.9.9</version.token-sheriff>
        <!-- The git-document-repository libraries have no release yet; their snapshots come from the
             Sonatype snapshot repository declared below. A release of Audit Notary needs a release of them. -->
        <version.git-document-repository>0.1.0-SNAPSHOT</version.git-document-repository>
    </properties>
    <!-- The modules of doc/specification/architecture-and-modules.adoc, in reactor order; categories and
         deployment are added when they are built. -->
    <modules>
        <module>web-app</module>
        <module>web-mock</module>
        <module>audit-notary</module>
        <module>web-e2e</module>
        <module>integration-tests</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <!-- Import order as specified: quarkus-bom first, so Quarkus wins version conflicts, then the
                 Token Sheriff BOM, then the git-document-repository versions. -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss.sheriff.token</groupId>
                <artifactId>token-sheriff-bom</artifactId>
                <version>${version.token-sheriff}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>git-core</artifactId>
                <version>${version.git-document-repository}</version>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>git-store</artifactId>
                <version>${version.git-document-repository}</version>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>git-testing</artifactId>
                <version>${version.git-document-repository}</version>
            </dependency>
            <dependency>
                <groupId>de.cuioss.notary.audit</groupId>
                <artifactId>audit-notary-web-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <repositories>
        <!-- Snapshots only: the git-document-repository libraries until their first release. -->
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
