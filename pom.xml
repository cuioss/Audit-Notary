<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-quarkus-parent</artifactId>
        <version>1.7.7</version>
        <relativePath/>
    </parent>
    <artifactId>trailhand-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- Must be declared: <inceptionYear> is inherited, and the license plugin binds the
         copyright ${year} to it. Without this, a new project reports cui-parent-pom's 2022
         and every -Ppre-commit run restamps every header. customize.sh sets this. -->
    <inceptionYear>2026</inceptionYear>
    <name>TrailHand</name>
    <description>TrailHand, the CISO's friend: security documents as versioned Git documents on the Git server you already run. Quarkus native, with a web app and an MCP server for AI agents.
    </description>
    <url>https://github.com/cuioss/TrailHand/</url>
    <scm>
        <url>https://github.com/cuioss/TrailHand/</url>
        <connection>
            scm:git:https://github.com/cuioss/TrailHand.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/cuioss/TrailHand/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/cuioss/TrailHand/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>
    <properties>
        <!-- Target Java 25; CI also builds on 27 (.github/project.yml, maven-build.java-versions). -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>
    <!-- The modules of doc/specification/architecture-and-modules.adoc are added when they are built:
         categories, web-app, trailhand, web-e2e, integration-tests, deployment. -->
</project>
