  "states": {
    "ready": {
      "description": "Everything is fetched; the Due list is populated."
    },
    "saved-by-other": {
      "description": "Another assessor saved two answers of Strategy and Metrics in the open assessment; a document-saved event follows, and the assessment reads with them.",
      "events": [
        {
          "after_ms": 300,
          "event": "document-saved",
          "data": {
            "repository": "samm-assessments",
            "id": "payments-2026-q4",
            "fields": [
              "/answers/sm/sm-b-1/answer",
              "/answers/sm/sm-b-2/answer"
            ]
          }
        }
      ],
      "routes": {
        "GET /api/v1/documents/samm-assessments/payments-2026-q4": {
          "body_file": "samm-assessment-payments-2026-q4-saved-by-other.json"
        }
      }
    },
    "conflict": {
      "description": "Another assessor saved the same answers of Strategy and Metrics first: a save for everyone answers CONFLICT with both values.",
      "routes": {
        "POST /api/v1/documents/samm-assessments/payments-2026-q4/save": {
          "status": 409,
          "body": {
            "outcome": "CONFLICT",
            "conflicts": [
              {
                "part": "sm",
                "blob": "5d1e9a0",
                "fields": [
                  {
                    "pointer": "/answers/sm/sm-a-2/answer",
                    "own": 0.5,
                    "other": 1,
                    "by": {
                      "pseudonym": "p-2b7f10",
                      "name": "Jordan Weber",
                      "role": "Team Lead"
                    }
                  },
                  {
                    "pointer": "/answers/sm/sm-b-1/answer",
                    "own": 0.25,
                    "other": 0.5,
                    "by": {
                      "pseudonym": "p-2b7f10",
                      "name": "Jordan Weber",
                      "role": "Team Lead"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "forbidden": {
      "description": "The rights were withdrawn meanwhile: the Due list is refused.",
      "routes": {
        "GET /api/v1/due": {
          "status": 403,
          "body": {
            "outcome": "FORBIDDEN"
          }
        }
      }
    },
    "session-replaced": {
      "description": "Another login in the same browser replaced the session: the open event streams close and the session gets a new anti-CSRF token; the tab reads the session again and reloads.",
      "session_replaced": true
    },
    "session-ended": {
      "description": "The provider ended the session (back-channel logout): the event streams close and the next request answers UNAUTHENTICATED.",
      "session_ended": true
    },
    "preview-hostile": {
      "description": "The renderer answers HTML that the allow-list must cut down: the web app shows no script, no handler, no unsafe link.",
      "routes": {
        "POST /api/v1/render/asciidoc": {
          "status": 200,
          "body_file": "render-asciidoc-hostile.json"
        }
      }
    },
    "preview-unavailable": {
      "description": "The renderer cannot run: no preview, the editing goes on.",
      "routes": {
        "POST /api/v1/render/asciidoc": {
          "status": 503,
          "body": {
            "outcome": "RENDER_UNAVAILABLE"
          }
        }
      }
    }
  }
