      "value": {
        "title": "Secure development policy",
        "owner": "role:ciso",
        "purpose": "This policy states what a team does so that the software it builds can be operated safely.",
        "statements": "Every change of the software is reviewed by a second person before it is released.\n\n* Dependencies are checked for known vulnerabilities at every build and every week.\n* Secrets are never stored in the source code; a secret that was committed is replaced at once.\n* A threat model exists for every service with a very high protection need.",
        "applies-to": [
          "team:payments",
          "team:identity",
          "team:mobile"
        ],
        "review-due": "2027-02-12"
      }
    }
  },
