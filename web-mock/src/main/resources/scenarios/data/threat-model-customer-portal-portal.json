        "threats": [
          {
            "id": "T-01",
            "name": "Direct access to another customer's order page",
            "description": "A customer changes the order number in the address and sees an order that is not theirs.",
            "categories": [
              "Information Disclosure"
            ],
            "risk": {
              "likelihood": 60,
              "impact": 75
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-02",
            "name": "Script injected through an order note",
            "description": "Text typed into an order note is shown to staff without being cleaned and runs as a script.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 75
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-03",
            "name": "Session theft on a shared device",
            "description": "The next person on a shared device continues the session of the last one.",
            "categories": [
              "Spoofing"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 50
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-04",
            "name": "Clickjacking of the account page",
            "description": "The account page is framed by another site and the customer is tricked into clicking.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 50
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-05",
            "name": "Enumeration of customer numbers",
            "description": "Customer numbers can be counted up and tried, which shows which of them exist.",
            "categories": [
              "Information Disclosure"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 25
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-06",
            "name": "Loss of availability in a sales peak",
            "description": "A sales peak exceeds the capacity of the portal; a loss of up to an hour is accepted.",
            "categories": [
              "Denial of Service"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 50
            },
            "attributes": {
              "status": "accepted"
            }
          }
        ],
        "mitigations": [
          {
            "id": "M-03",
            "name": "End the session after ten idle minutes",
            "description": "An idle session is closed and has to be started again.",
            "riskReduction": 80,
            "attributes": {
              "threat": "T-03",
              "status": "implemented",
