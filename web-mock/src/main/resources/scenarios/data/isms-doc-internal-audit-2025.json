          "to": "2025-11-30"
        },
        "auditors": [
          "p-9e33a1",
          "p-61c0d4"
        ],
        "audited": "The access control, the handling of incidents and the management of suppliers.",
        "findings": [
          {
            "severity": "major",
            "text": "The accounts of suppliers are not reviewed when a project ends.",
            "issues": [
              "SEC-290"
            ]
          },
          {
            "severity": "minor",
            "text": "Two of five sampled access reviews were not documented.",
            "issues": [
              "SEC-281"
            ]
          },
          {
            "severity": "minor",
            "text": "The contact list for incidents was out of date.",
            "issues": []
          },
          {
            "severity": "observation",
            "text": "The restore of a backup was never tested.",
            "issues": [
              "OPS-211"
            ]
          }
        ],
        "conclusion": "The ISMS works as designed. One major finding, the review of supplier accounts, is to be closed before the next audit.",
        "related": [
          "isms-register:risk/R-009"
        ]
      }
    }
  },
