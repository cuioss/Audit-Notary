    "review": {
      "blob": "cbc22be",
      "savedAt": "2026-11-17T15:00:00Z",
      "savedBy": {
        "pseudonym": "p-4c1a9e",
        "name": "Alex Example",
        "role": "Security Champion"
      },
      "value": {
        "root-causes": [
          {
            "category": "process",
            "description": "The deployment script did not wait for the health check of the new version."
          },
          {
            "category": "configuration",
            "description": "The sending queue had no limit, so the backlog hit the service at once when it came back."
          }
        ],
        "measures": [
          {
            "what": "Make the deployment wait for the health check and roll back by itself",
            "role": "role:developer",
            "issues": [
              "NS-318"
            ],
            "due": "2026-11-30"
          },
          {
            "what": "Limit the rate at which the queue is drained",
            "role": "role:service-owner",
            "issues": [
              "NS-319"
            ],
            "due": "2026-12-15"
          }
        ],
        "risks": [
          "isms-register:risk/R-004"
        ],
        "course": "A deployment replaced the notification service by a version that did not start properly. No message was sent for about 35 hours until the rollback finished and the backlog was drained.",
        "root-cause-analysis": "The script switched the traffic before the health check had passed. The queue kept all messages, which is the intended behaviour, but nothing limited the rate when the service came back.",
        "lessons": "The queue protected the messages. The deployment must protect the service.\n\n* A deployment is finished when the health check has passed.\n* The status page must be updated by the first responder.",
        "completion": {
          "at": "2026-11-17T15:00:00Z",
          "by": "p-4c1a9e"
        }
      }
    }
  },
