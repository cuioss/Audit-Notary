      "value": {
        "title": "Build agents run unpatched images",
        "description": "The build agents are started from a base image that is rebuilt only when somebody asks for it. Known vulnerabilities in the image reach the agents that compile and sign our releases. Two agents were found with a kernel that was older than the last security update of the vendor.",
        "rating": "high",
        "treatment": "mitigate",
        "treatment-notes": "Rebuild the base image every week and replace the agents that run longer than a week.",
        "owner": "team:security-office",
        "owner-role": "role:service-owner",
