      "value": {
        "title": "Scope of the ISMS",
        "owner": "role:ciso",
        "boundaries": "The ISMS covers the development, the operation and the support of the payment products and of the platform they run on, including the mobile apps.\n\n* The locations of the organisation and the home offices of its staff.\n* The systems of the core platform and the services of the catalog.\n* The suppliers that run a part of the operation.",
        "exclusions": [
          {
            "what": "Marketing websites",
            "reason": "They hold no customer data and run outside the production network."
          },
          {
            "what": "Office printers and telephones",
            "reason": "They process no customer data and are managed by the landlord."
          }
        ],
        "interested-parties": "Customers, the supervisory authority, the payment providers and the staff.",
        "review-due": "2026-11-20"
      }
    }
  },
