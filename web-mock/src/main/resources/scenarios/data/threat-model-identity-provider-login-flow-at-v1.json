        "threats": [
          {
            "id": "T-01",
            "name": "Credential stuffing against the login form",
            "description": "Lists of leaked passwords are tried against the login form at scale.",
            "categories": [
              "Spoofing"
            ],
            "risk": {
              "likelihood": 60,
              "impact": 75
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-02",
            "name": "Session fixation after login",
            "description": "The session identifier from before the login stays valid, so an attacker who set it takes over the session.",
            "categories": [
              "Spoofing",
              "Elevation of Privilege"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 90
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-03",
            "name": "Token replay from a leaked refresh token",
            "description": "A refresh token taken from a log or a device is used again by someone else.",
            "categories": [
              "Spoofing"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 90
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-05",
            "name": "Tampering with the redirect address",
            "description": "The redirect address after the login is changed to send the customer to a fake site.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 75
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-06",
            "name": "Phishing of the second factor",
            "description": "A fake login page asks for the second factor and passes it on in real time.",
            "categories": [
              "Spoofing"
            ],
            "risk": {
              "likelihood": 50,
              "impact": 75
            },
            "attributes": {
              "status": "mitigated"
            }
          }
        ],
        "mitigations": [
          {
            "id": "M-05",
            "name": "Allow-list for redirect addresses",
            "description": "Only registered addresses are accepted after the login.",
            "riskReduction": 90,
            "attributes": {
