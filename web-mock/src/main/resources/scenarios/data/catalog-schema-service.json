{
  "catalog": "service",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "id",
      "name",
      "lifecycle",
      "owner",
      "protection-needs"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(?!(?:new|schema)$)[a-z0-9][a-z0-9-]{0,63}$"
      },
      "name": {
        "type": "string",
        "maxLength": 120
      },
      "description": {
        "type": "string",
        "maxLength": 500,
        "x-free-text": true
      },
      "system": {
        "type": "string",
        "format": "gdr-link",
        "x-catalog": "system"
      },
      "lifecycle": {
        "type": "string",
        "enum": [
          "planned",
          "active",
          "deprecated"
        ]
      },
      "owner": {
        "type": "object",
        "required": [
          "team",
          "role"
        ],
        "properties": {
          "team": {
            "type": "string",
            "format": "gdr-link",
            "x-catalog": "team"
          },
          "role": {
            "type": "string",
            "format": "gdr-link",
            "x-catalog": "role"
          }
        }
      },
      "repositories": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "format": "uri",
          "maxLength": 300
        }
      },
      "dependsOn": {
        "type": "array",
        "maxItems": 50,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "gdr-link",
          "x-catalog": [
            "service",
            "external"
          ]
        }
      },
      "protection-needs": {
        "type": "object",
        "required": [
          "confidentiality",
          "integrity",
          "availability"
        ],
        "properties": {
          "confidentiality": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "very-high"
            ]
          },
          "integrity": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "very-high"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "very-high"
            ]
          }
        }
      },
      "data-classes": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 60
        }
      }
    }
  }
}
