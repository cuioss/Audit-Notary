      "value": {
        "root-causes": [
          {
            "category": "process",
            "description": "The recovery key was kept with the laptop."
          }
        ],
        "measures": [
          {
            "what": "Store the recovery key in the key service, never with the device",
            "role": "role:service-owner",
            "issues": [
              "IT-890"
            ],
            "due": "2025-05-31"
          }
        ],
        "risks": [
          "isms-register:risk/R-021"
        ],
        "course": "A laptop was left in a train. The disk was encrypted. The recovery key was on a card in the laptop bag.",
        "root-cause-analysis": "The rules for the handling of recovery keys were known but not checked when a laptop was handed out.",
        "lessons": "A key kept with the device protects nothing. The handover of a laptop now includes the check of the key.",
        "completion": {
          "at": "2025-04-28T14:00:00Z",
          "by": "p-4c1a9e"
        }
      }
