        "threats": [
          {
            "id": "T-01",
            "name": "Backups leave the data centre unencrypted",
            "description": "A backup medium that is lost or stolen on the way holds the data in plain text.",
            "categories": [
              "Information Disclosure"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 90
            },
            "attributes": {
              "status": "open"
            }
          },
          {
            "id": "T-02",
            "name": "A service account of another team reads the tables",
            "description": "A service account with too wide rights reads tables it has no business with.",
            "categories": [
              "Elevation of Privilege"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 75
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-03",
            "name": "A faulty migration alters rows",
            "description": "A migration with a mistake changes or deletes rows without anyone noticing.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 30,
              "impact": 90
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-04",
            "name": "Loss of the primary database",
            "description": "The primary database fails and the service stands still until a replacement is up.",
            "categories": [
              "Denial of Service"
            ],
            "risk": {
              "likelihood": 30,
              "impact": 90
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-05",
            "name": "Administrators can read personal data in plain text",
            "description": "An administrator with access to the console can read the personal data of customers.",
            "categories": [
              "Information Disclosure"
            ],
            "risk": {
              "likelihood": 25,
              "impact": 75
            },
            "attributes": {
              "status": "accepted"
            }
          }
        ],
        "mitigations": [
          {
            "id": "M-01",
            "name": "Encrypt backups before they leave the data centre",
            "description": "The backup job encrypts with a key held in the key service.",
            "riskReduction": 90,
            "attributes": {
              "threat": "T-01",
              "status": "planned",
