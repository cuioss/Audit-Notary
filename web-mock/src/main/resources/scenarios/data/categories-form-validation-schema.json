{
  "category": "form-validation",
  "kinds": [
    {
      "id": "validation",
      "repository": "test-notes",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "code",
          "title",
          "severity",
          "opened"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[0-9]{3}$",
            "maxLength": 6
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "opened": {
            "type": "string",
            "format": "date-time"
          },
          "closed": {
            "type": "string",
            "format": "date"
          },
          "acknowledged": {
            "type": "boolean",
            "const": true
          },
          "link": {
            "type": "string",
            "format": "gdr-link"
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "gdr-link"
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 30
                },
                "passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}
