        "threats": [
          {
            "id": "T-01",
            "name": "A report contains data the requester may not see",
            "description": "A report is built from more data than the rights of the requester allow.",
            "categories": [
              "Information Disclosure"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 75
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-02",
            "name": "Template injection in a report layout",
            "description": "A layout with code in it runs on the server when the report is rendered.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 30,
              "impact": 90
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-03",
            "name": "Large reports exhaust memory",
            "description": "A very large report uses up the memory of the engine and stops the others.",
            "categories": [
              "Denial of Service"
            ],
            "risk": {
              "likelihood": 40,
              "impact": 50
            },
            "attributes": {
              "status": "mitigated"
            }
          },
          {
            "id": "T-04",
            "name": "The report archive can be changed by an operator",
            "description": "An operator with access to the archive can change a report after it was sent.",
            "categories": [
              "Tampering"
            ],
            "risk": {
              "likelihood": 20,
              "impact": 50
            },
            "attributes": {
              "status": "accepted"
            }
          }
        ],
        "mitigations": [
          {
            "id": "M-01",
            "name": "Filter every report by the rights of the requester",
