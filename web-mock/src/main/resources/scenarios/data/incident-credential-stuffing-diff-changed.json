    {
      "part": "review",
      "changes": [
        {
          "pointer": "/root-causes",
          "before": null,
          "after": [
            {
              "category": "configuration",
              "description": "The rate limit of the login form counted per session, so a client without cookies was never limited."
            },
            {
              "category": "access-control",
              "description": "Passwords from public leaks were still accepted when a user chose them."
            }
          ]
        },
        {
          "pointer": "/measures",
          "before": null,
          "after": [
            {
              "what": "Limit the attempts per address range and per account",
              "role": "role:developer",
              "issues": [
                "ID-911"
              ],
              "due": "2026-12-15"
            },
            {
              "what": "Check new passwords against a list of leaked ones",
              "role": "role:developer",
              "issues": [
                "ID-912"
              ],
              "due": "2027-01-31"
            }
          ]
        },
        {
          "pointer": "/course",
          "before": null,
          "after": "The alert on failed logins fired within minutes. The traffic came from a few address ranges and tried leaked credentials at a high rate. Blocking the ranges and enabling the rate limit stopped it within two hours."
        },
        {
          "pointer": "/root-cause-analysis",
          "before": null,
          "after": "The login form limited the attempts per session only, so a client that sent no cookie was never limited. In addition, passwords that are known from public leaks were still accepted at sign-up and at a password change."
        },
        {
          "pointer": "/lessons",
          "before": null,
          "after": "The alert and the block list worked as intended; two gaps remain.\n\n* The limit must apply per address range and per account.\n* New passwords must be checked against known leaks."
        },
