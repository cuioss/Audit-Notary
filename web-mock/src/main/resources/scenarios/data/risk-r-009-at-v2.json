      "value": {
        "title": "Replay of payment authorisations in the checkout flow",
        "description": "A recorded authorisation of a payment can be sent to the checkout flow again and charges the customer twice. The payment provider confirmed in a test that a replayed authorisation is accepted within the replay window.",
        "rating": "critical",
        "treatment": "mitigate",
        "treatment-notes": "Bind every authorisation to a nonce and refuse a nonce that was used before.",
        "owner": "team:payments",
        "owner-role": "role:service-owner",
        "review-due": "2027-02-11",
