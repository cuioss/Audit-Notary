        "name": "Alex Example",
        "role": "Security Champion"
      },
      "value": {
        "root-causes": [
          {
            "category": "software-defect",
            "description": "The template put the recipients in the visible address field."
          },
          {
            "category": "third-party",
            "description": "The mailing platform did not warn about more than one visible recipient."
          }
        ],
        "measures": [
          {
            "what": "Test every campaign template with two recipients before the first send",
            "role": "role:developer",
            "issues": [
              "NS-210"
            ],
            "due": "2025-11-15"
          }
        ],
        "course": "A newsletter went to all subscribers with every address visible. The template was corrected within a day.",
        "root-cause-analysis": "A change to the template replaced the blind copy field by the normal one. No test sent a mail to more than one recipient.",
        "lessons": "A deadline is only as good as the first report. The complaint reached the team two days after the mail; the reporting path of the mailing platform must name the security team.",
        "completion": {
          "at": "2025-10-17T14:00:00Z",
          "by": "p-4c1a9e"
        }
      }
    }
