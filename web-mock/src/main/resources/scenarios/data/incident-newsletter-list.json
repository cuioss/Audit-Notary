        "name": "Jordan Weber",
        "role": "Developer"
      },
      "value": {
        "actions": [
          {
            "kind": "containment",
            "what": "Stop the campaign and ask the mailing platform to recall the queued mails",
            "role": "role:service-owner",
            "issues": [
              "NS-201"
            ],
            "done": true
          },
          {
            "kind": "recovery",
            "what": "Move the recipients to the blind copy field and check every template",
            "role": "role:developer",
            "issues": [
              "NS-202"
            ],
            "done": true
          }
        ],
        "timeline": [
          {
            "at": "2025-09-08T06:40:00Z",
            "what": "A subscriber reports that the newsletter shows other addresses."
          },
          {
            "at": "2025-09-09T12:00:00Z",
            "what": "The templates are corrected and the campaign is sent again."
          }
        ],
        "resolved-at": "2025-09-09T12:00:00Z",
