          "path": "/api/v1/catalogs/service/customer-portal/retirement",
          "next": "service-retired",
          "status": 200,
          "body": {
            "outcome": "RETIRED",
            "catalog": "service",
            "id": "customer-portal",
            "at": "2026-11-26T09:35:00Z"
