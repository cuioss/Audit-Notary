  "states": {
    "review": {
      "description": "The assessment is in review; the session has no fresh MFA: the release answers STEP_UP_REQUIRED with the step-up address.",
      "links": {
        "release": {
          "method": "POST",
          "path": "/api/v1/releases/samm-assessments/payments-2026-q4",
          "next": "stepped-up",
          "status": 403,
          "body": {
            "outcome": "STEP_UP_REQUIRED",
            "stepUp": "/api/v1/auth/login?step-up=mfa"
          }
        }
      }
    },
    "stepped-up": {
      "description": "Back from the identity provider with a fresh MFA: the release succeeds.",
      "links": {
        "release": {
          "method": "POST",
          "path": "/api/v1/releases/samm-assessments/payments-2026-q4",
          "next": "released",
          "body": {
            "outcome": "RELEASED",
            "tag": "assessments/payments-2026-q4/v1",
            "at": "2026-11-25T11:20:00Z"
          }
        }
      }
    },
    "password": {
      "description": "Local users: the release asks for the password and sends it with the request.",
      "routes": {
        "GET /api/v1/status": {
          "status": 200,
          "body": {
            "version": "0.1.0-SNAPSHOT",
            "degraded": false,
            "loginProvider": "local",
            "repositories": [
              {
                "alias": "samm-assessments",
                "fetch": "UP"
              },
              {
                "alias": "threat-models",
                "fetch": "UP"
              },
              {
                "alias": "isms-register",
                "fetch": "UP"
              },
              {
                "alias": "isms-incidents-2026",
                "fetch": "UP"
              },
              {
                "alias": "directory",
                "fetch": "UP"
              }
            ],
            "stepUp": "password"
          }
        }
      },
      "links": {
        "release": {
          "method": "POST",
          "path": "/api/v1/releases/samm-assessments/payments-2026-q4",
          "next": "released",
          "body": {
            "outcome": "RELEASED",
            "tag": "assessments/payments-2026-q4/v1",
            "at": "2026-11-25T11:20:00Z"
          }
        }
      }
    },
    "wrong-password": {
      "description": "Local users: a wrong password; nothing is released.",
      "routes": {
        "GET /api/v1/status": {
          "status": 200,
          "body": {
            "version": "0.1.0-SNAPSHOT",
            "degraded": false,
            "loginProvider": "local",
            "repositories": [
              {
                "alias": "samm-assessments",
                "fetch": "UP"
              },
              {
                "alias": "threat-models",
                "fetch": "UP"
              },
              {
                "alias": "isms-register",
                "fetch": "UP"
              },
              {
                "alias": "isms-incidents-2026",
                "fetch": "UP"
              },
              {
                "alias": "directory",
                "fetch": "UP"
              }
            ],
            "stepUp": "password"
          }
        },
        "POST /api/v1/releases/samm-assessments/payments-2026-q4": {
          "status": 401,
          "body": {
            "outcome": "INVALID_CREDENTIALS"
          }
        }
      }
    },
    "changed": {
      "description": "Someone saved after the review was opened: the release answers CHANGED_SINCE_REVIEW and the view reads the diff again.",
      "links": {
        "release": {
          "method": "POST",
          "path": "/api/v1/releases/samm-assessments/payments-2026-q4",
          "next": "stepped-up",
          "status": 409,
          "body": {
            "outcome": "CHANGED_SINCE_REVIEW"
          }
        }
      }
    },
    "too-many-logins": {
      "description": "Every place of pending logins is taken: the release cannot start its step-up; nothing is written.",
      "links": {
        "release": {
          "method": "POST",
          "path": "/api/v1/releases/samm-assessments/payments-2026-q4",
          "next": "too-many-logins",
          "status": 503,
          "body": {
            "outcome": "TOO_MANY_LOGINS"
          }
        }
      }
    },
    "released": {
      "description": "The assessment is released as v1 and frozen.",
      "routes": {
        "GET /api/v1/samm/scopes/payments": {
          "body_file": "samm-scope-payments-released.json"
        },
        "GET /api/v1/documents/samm-assessments/payments-2026-q4": {
          "body_file": "samm-assessment-payments-2026-q4-released.json"
        },
        "GET /api/v1/samm/scopes": {
          "body_file": "samm-scopes-release-released.json"
        },
        "GET /api/v1/samm/payments/trend": {
          "body_file": "samm-trend-payments-released.json"
        }
      }
    },
    "released-meanwhile": {
      "description": "Somebody released Payments 2026 Q4 while it was in review: the release answers DOCUMENT_RELEASED with the tag, and the assessment, the scope, the list and the trend read as released.",
      "routes": {
        "POST /api/v1/releases/samm-assessments/payments-2026-q4": {
          "status": 409,
          "body": {
            "outcome": "DOCUMENT_RELEASED",
            "tag": "assessments/payments-2026-q4/v1"
          }
        },
        "GET /api/v1/samm/scopes/payments": {
          "body_file": "samm-scope-payments-released.json"
        },
        "GET /api/v1/documents/samm-assessments/payments-2026-q4": {
          "body_file": "samm-assessment-payments-2026-q4-released.json"
        },
        "GET /api/v1/samm/scopes": {
          "body_file": "samm-scopes-release-released.json"
        },
        "GET /api/v1/samm/payments/trend": {
          "body_file": "samm-trend-payments-released.json"
        }
      }
    }
