          },
          {
            "id": "ciso",
            "name": "Chief Information Security Officer"
          }
        ]
      }
    },
    "GET /api/v1/directory/me": {
      "status": 200,
      "body": {
        "name": "Robin Newcomer",
        "teams": [
          "payments"
        ],
        "informationText": "Audit Notary stores your name, team and role in the person directory of your organisation so that documents can name who worked on them. Documents carry only a pseudonym; the directory maps it to your entry. Controller: the security office of your organisation. Legal basis: Art. 6(1)(b) and (f) GDPR. You can change your entry at any time in Settings; erasure is done by the catalog administrators. (Information under Art. 13 GDPR.)",
        "entry": null
      }
    }
  },
  "states": {
    "form": {
      "description": "The first-login form is shown; saving creates the entry.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "registered",
          "status": 200,
          "body": {
            "outcome": "SAVED",
            "pseudonym": "p-9b7e21"
          }
        }
      }
    },
    "invalid-team": {
      "description": "Saving is refused: the team is not in the catalog.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "invalid-team",
          "status": 422,
          "body": {
            "outcome": "VALIDATION",
            "errors": [
              {
                "pointer": "/team",
                "code": "REFERENCE_NOT_FOUND"
              }
            ]
          }
        }
      }
    },
    "registered": {
      "description": "The entry is saved as a new one (p-9b7e21); the user works like any other.",
      "first_login_required": false,
      "routes": {
        "GET /api/v1/due": {
          "status": 200,
          "body": {
            "items": [
              {
                "kind": "review",
                "lens": "samm",
                "title": "Payments 2026 Q4: Strategy and Metrics",
                "address": "/samm/payments/2026-q4/sm",
                "due": "2026-11-27"
