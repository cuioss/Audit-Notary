        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "registered-bound",
          "status": 200,
          "body": {
            "outcome": "SAVED",
            "pseudonym": "p-3d7a15"
          }
        }
      }
    },
    "candidates-not-bindable": {
      "description": "As candidates, but the first choice is refused (NOT_BINDABLE) and the form shows the candidates again.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "candidates-refused",
          "status": 409,
          "body": {
            "outcome": "BINDING_CANDIDATES",
            "candidates": [
              {
                "pseudonym": "p-3d7a15",
                "name": "Robin Newcomer",
                "memberships": [
                  {
                    "team": "team:payments",
                    "role": "role:developer"
                  }
                ]
              },
              {
                "pseudonym": "p-8e2b40",
                "name": "Rowan Newman",
                "memberships": [
                  {
                    "team": "team:payments",
                    "role": "role:developer"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "candidates-refused": {
      "description": "The chosen entry cannot be bound (NOT_BINDABLE, for example it was bound meanwhile); the next save with another choice succeeds.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "candidates-chosen",
          "status": 409,
          "body": {
            "outcome": "NOT_BINDABLE"
          }
        }
      }
