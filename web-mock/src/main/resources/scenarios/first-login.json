            "entry": {
              "pseudonym": "p-9b7e21",
              "name": "Robin Newcomer",
              "memberships": [
                {
                  "team": "team:payments",
                  "role": "role:developer"
                }
              ],
              "confirmedAt": "2026-11-26",
              "confirmationDue": false
            }
          }
        }
      }
    },
    "registered-bound": {
