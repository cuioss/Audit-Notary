    "GET /api/v1/catalogs/role": {
      "status": 200,
      "body": {
        "entries": [
          {
            "id": "developer",
            "name": "Developer"
          },
          {
            "id": "product-owner",
            "name": "Product Owner"
          },
          {
            "id": "security-champion",
