            "fetch": "UP"
          },
          {
            "alias": "isms-incidents-2026",
            "fetch": "UP"
          },
          {
            "alias": "directory",
            "fetch": "UP"
          }
        ]
      }
    },
    "GET /api/v1/catalogs/team": {
      "status": 200,
