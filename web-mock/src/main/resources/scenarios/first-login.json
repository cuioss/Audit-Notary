    "candidates": {
      "description": "The first save finds prefilled entries with the same team and role: it is refused with the candidates, nothing is saved; the repeated save with a choice creates or binds the entry.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "candidates-chosen",
          "status": 409,
          "body": {
            "outcome": "BINDING_CANDIDATES",
            "candidates": [
              {
                "pseudonym": "p-3d7a15",
                "name": "Robin Newcomer",
                "memberships": [
                  {
                    "team": "team:payments",
                    "role": "role:developer"
                  }
                ]
              },
              {
                "pseudonym": "p-8e2b40",
                "name": "Rowan Newman",
                "memberships": [
                  {
                    "team": "team:payments",
                    "role": "role:developer"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "candidates-chosen": {
      "description": "The user chose a candidate or a new entry: the save binds the entry p-3d7a15.",
