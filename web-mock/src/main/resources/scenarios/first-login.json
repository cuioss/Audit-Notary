  "states": {
    "form": {
      "description": "The first-login form is shown; saving creates the entry.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "registered",
          "status": 200,
          "body": {
            "outcome": "SAVED",
            "pseudonym": "p-9b7e21"
          }
        }
      }
    },
    "invalid-team": {
      "description": "Saving is refused: the team is not in the catalog.",
      "links": {
        "save-entry": {
          "method": "PUT",
          "path": "/api/v1/directory/me",
          "next": "invalid-team",
          "status": 422,
          "body": {
            "outcome": "VALIDATION",
            "errors": [
              {
                "pointer": "/team",
                "code": "REFERENCE_NOT_FOUND"
              }
            ]
          }
        }
      }
    },
    "registered": {
      "description": "The entry is saved; the user works like any other.",
      "first_login_required": false,
      "routes": {
        "GET /api/v1/due": {
          "status": 200,
