{
  "name": "audit-notary-web-app",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "The Audit Notary web app (doc/specification/web-app.adoc)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.17",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build-output.mjs",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && stylelint \"src/**/*.{css,svelte}\" && node scripts/text-literal-lint.mjs --self-test && node scripts/text-literal-lint.mjs",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,svelte}\" --fix",
    "lint:text": "node scripts/text-literal-lint.mjs",
    "format": "prettier --write \"src/**/*.{ts,js,svelte,css,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,css,json}\" \"scripts/**/*.mjs\"",
    "quality": "npm run lint && npm run test:ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.3.3",
    "stylelint": "^16.14.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.4"
  }
}
