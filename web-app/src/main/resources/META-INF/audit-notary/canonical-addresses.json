{
  "description": "The canonical addresses of the web app (doc/specification/web-app.adoc, AUN-WEB-3). One source for the router of the web app, the return check of the login (AUN-AUTH-1) and the mock server. A {name} placeholder matches one path segment of the pattern named in params, or the default segment pattern. The addresses of outsideShell are routed by the web app without the shell (doc/specification/rest-api.adoc, Addresses Outside the Shell); they are deliberately not in addresses, so that the check of a login's return never accepts them.",
  "segment": "[a-z0-9][a-z0-9._-]{0,127}",
  "params": {
    "year": "[0-9]{4}",
    "document": "[0-9A-Za-z][0-9A-Za-z._-]{0,127}"
  },
  "queries": {
    "at": "(v[0-9]{1,4}|[0-9a-f]{7,40})",
    "kind": "[a-z0-9][a-z0-9-]{0,63}"
  },
  "addresses": [
    { "route": "due", "pattern": "/" },
    { "route": "welcome", "pattern": "/welcome" },
    { "route": "samm", "pattern": "/samm" },
    { "route": "samm.scope", "pattern": "/samm/{scope}" },
    { "route": "samm.assessment", "pattern": "/samm/{scope}/{assessment}" },
    { "route": "samm.release", "pattern": "/samm/{scope}/{assessment}/release" },
    { "route": "samm.practice", "pattern": "/samm/{scope}/{assessment}/{practice}" },
    { "route": "threat-models", "pattern": "/threat-models" },
    { "route": "threat-models.service", "pattern": "/threat-models/{service}" },
    { "route": "threat-models.model", "pattern": "/threat-models/{service}/{model}" },
    { "route": "threat-models.release", "pattern": "/threat-models/{service}/{model}/release" },
    { "route": "incidents", "pattern": "/incidents" },
    { "route": "incidents.year", "pattern": "/incidents/{year}" },
    { "route": "incidents.incident", "pattern": "/incidents/{year}/{incident}" },
    { "route": "incidents.release", "pattern": "/incidents/{year}/{incident}/release" },
    { "route": "isms", "pattern": "/isms" },
    { "route": "isms.risks", "pattern": "/isms/risks" },
    { "route": "isms.risk", "pattern": "/isms/risks/{entry}" },
    { "route": "isms.risk.release", "pattern": "/isms/risks/{entry}/release" },
    { "route": "isms.documents", "pattern": "/isms/documents" },
    { "route": "isms.document", "pattern": "/isms/documents/{id}" },
    { "route": "isms.document.release", "pattern": "/isms/documents/{id}/release" },
    { "route": "categories", "pattern": "/categories" },
    { "route": "categories.category", "pattern": "/categories/{category}" },
    { "route": "categories.new", "pattern": "/categories/{category}/new", "query": ["kind"] },
    {
      "route": "categories.document",
      "pattern": "/categories/{category}/{document}",
      "query": ["at"]
    },
    { "route": "categories.release", "pattern": "/categories/{category}/{document}/release" },
    { "route": "catalogs", "pattern": "/catalogs" },
    { "route": "catalogs.catalog", "pattern": "/catalogs/{catalog}" },
    { "route": "catalogs.entry", "pattern": "/catalogs/{catalog}/{id}" },
    { "route": "reports", "pattern": "/reports" },
    { "route": "reports.report", "pattern": "/reports/{report}" },
    { "route": "settings", "pattern": "/settings" },
    { "route": "settings.section", "pattern": "/settings/{section}" }
  ],
  "outsideShell": [
    { "route": "login", "pattern": "/login" },
    { "route": "signed-out", "pattern": "/signed-out" },
    { "route": "login-problem", "pattern": "/login-problem" }
  ]
}
